{
  "quest.12E6801F4CAD3579.title": "Welcome to First Torch",
  "quest.12E6801F4CAD3579.quest_subtitle": "Your calm guide through Minecraft",
  "quest.12E6801F4CAD3579.quest_desc": [
    "Welcome! This quest book teaches Minecraft in small steps. You do not need to remember everything at once.",
    "",
    "Each quest explains the goal, why it matters, and the exact steps. Some tasks complete automatically when the item is in your inventory. A checkmark means that you decide when you have tried or understood the step.",
    "",
    "You can explore at your own pace. If you already know something, read the safety note and continue.",
  ],
  "task.23F7912A5DBE4680.title": "I am ready to begin",

  "quest.34A8023B6ECF5791.title": "Your Hands and Mouse Buttons",
  "quest.34A8023B6ECF5791.quest_subtitle": "Attack, break, use, and place",
  "quest.34A8023B6ECF5791.quest_desc": [
    "Goal: learn the two most important mouse buttons.",
    "",
    "By default, your character holds items in the right hand. You can see that hand at the lower-right of the screen.",
    "",
    "Left mouse button = attack button. Use it to attack or break a block. To break a block, keep holding it until the block breaks completely.",
    "",
    "Right mouse button = use button. Use it to interact with a block or place the item in your hand.",
    "",
    "{image:firsttorch:textures/questpics/attack_and_break.png width:320 height:180 align:center}",
    "",
    "If you are left-handed, you can change the main hand in the settings. Key bindings can be changed under Options → Controls.",
  ],
  "task.6A72C4E819B305FD.title": "I know the attack and use buttons",

  "quest.7B83D5F920C4160E.title": "From Tree to Wooden Planks",
  "quest.7B83D5F920C4160E.quest_subtitle": "Slowly: break, pick up, and craft a log",
  "quest.7B83D5F920C4160E.quest_desc": [
    "Goal: turn any log into four wooden planks.",
    "",
    "1. Walk to a tree and point the crosshair in the centre of the screen at its trunk.",
    "",
    "2. Hold the left mouse button. Wait until the cracks finish and the log block breaks.",
    "",
    "3. Walk over the small dropped log. It is picked up automatically and appears in your hotbar or inventory.",
    "",
    "4. Press E. Pick up the log with the left mouse button and place it in any one of the four Crafting spaces. It does not matter which space you use.",
    "",
    "5. Four planks appear in the result slot on the right. Click them, then click an empty inventory slot. Shift + left-click moves them directly into your inventory.",
    "",
    "{image:firsttorch:textures/questpics/log_to_planks.png width:320 height:180 align:center}",
    "",
    "The quest completes automatically when four planks of any wood type are in your inventory. Mixed wood types count together too.",
  ],
  "task.45B9134C7FDA6802.title": "Hold 4 Wooden Planks of any wood type",

  "quest.56CA245D80EB7913.title": "A Proper Workbench",
  "quest.56CA245D80EB7913.quest_subtitle": "Unlock the full 3 × 3 crafting grid",
  "quest.56CA245D80EB7913.quest_desc": [
    "Goal: craft a Crafting Table and place it on the ground.",
    "",
    "1. Press E. Put one wooden plank in each of the four spaces of the small 2 × 2 crafting grid. Click the Crafting Table in the result slot and place it in your hotbar.",
    "",
    "2. Close the inventory with E. Select the Crafting Table in your hotbar with the mouse wheel or its number key. You can now see it in your right hand.",
    "",
    "3. Point the crosshair at a clear ground block directly in front of you and press the right mouse button. The Crafting Table now stands there.",
    "",
    "{image:firsttorch:textures/questpics/place_crafting_table.png width:320 height:180 align:center}",
    "",
    "Press the right mouse button on the placed Crafting Table again. This opens the large 3 × 3 crafting grid.",
  ],
  "task.07DB356E91FC8A24.title": "Obtain a Crafting Table",

  "quest.18EC467FA20D9B35.title": "Your First Pickaxe",
  "quest.18EC467FA20D9B35.quest_subtitle": "The correct tool for stone",
  "quest.18EC467FA20D9B35.quest_desc": [
    "Goal: craft a Wooden Pickaxe.",
    "",
    "1. Open the Crafting Table. Put two planks vertically in its 3 × 3 grid. Any column works. Take the four sticks from the result slot.",
    "",
    "2. Open the placed Crafting Table with the right mouse button. Fill the entire top row with three planks. Put one stick in the exact centre and a second stick directly below it.",
    "",
    "3. Click the Wooden Pickaxe in the result slot and place it in your hotbar.",
    "",
    "{image:firsttorch:textures/questpics/wooden_pickaxe.png width:320 height:180 align:center}",
    "",
    "A pickaxe mines stone and ore. Using the wrong tool can be very slow and may destroy the drop.",
  ],
  "task.29FD5780B31EAC46.title": "Obtain a Wooden Pickaxe",

  "quest.3A0E6891C42FBD57.title": "Stone Age",
  "quest.3A0E6891C42FBD57.quest_subtitle": "Collect eight Cobblestone",
  "quest.3A0E6891C42FBD57.quest_desc": [
    "Goal: mine at least eight Cobblestone with your Wooden Pickaxe.",
    "",
    "Collecting stone works almost exactly like collecting wood: look at the block, hold the left mouse button, and pick up the dropped item. The important difference is the tool.",
    "",
    "1. Select the Wooden Pickaxe in your hotbar. You must be able to see it in your hand.",
    "",
    "2. Find grey stone on a hillside or near the surface and point the crosshair at it.",
    "",
    "3. Hold the left mouse button until the stone block breaks completely. Walk over the dropped Cobblestone; it is picked up automatically again.",
    "",
    "Repeat these three steps until eight Cobblestone are in your inventory at the same time. The quest deliberately stays incomplete at 1 through 7.",
    "",
    "Never dig straight down: you could fall into a cave, lava, or a deep hole.",
    "",
    "Keep a clear route back to daylight. Eight Cobblestone is enough for the next essential block.",
  ],
  "task.4B1F79A2D530CE68.title": "Hold 8 Cobblestone",

  "quest.5C208AB3E641DF79.title": "Build a Furnace",
  "quest.5C208AB3E641DF79.quest_subtitle": "Cook food and process ore",
  "quest.5C208AB3E641DF79.quest_desc": [
    "Goal: craft a Furnace.",
    "",
    "1. Open the Crafting Table with the right mouse button.",
    "",
    "2. Put Cobblestone in all eight outside spaces of the 3 × 3 grid. Leave the exact centre space empty.",
    "",
    "3. Take the Furnace from the result slot and place it in your inventory or hotbar.",
    "",
    "{image:firsttorch:textures/questpics/furnace.png width:320 height:180 align:center}",
    "",
    "The top furnace slot holds what you want to cook or smelt. The bottom slot holds fuel. Planks and logs work, but coal and charcoal last longer.",
  ],
  "task.6D319BC4F752E08A.title": "Obtain a Furnace",

  "quest.7E42ACD50863F19B.title": "First Torch",
  "quest.7E42ACD50863F19B.quest_subtitle": "Light makes a place safer and easier to find",
  "quest.7E42ACD50863F19B.quest_desc": [
    "Goal: make at least eight Torches.",
    "",
    "A torch is crafted from one coal or charcoal above one stick. Each pair makes four torches.",
    "",
    "No coal yet? Make Charcoal first:",
    "",
    "1. Place the Furnace just like the Crafting Table, then open it with the right mouse button.",
    "",
    "2. Put one log in the top slot. Put one wooden plank into the bottom fuel slot. Wait until the arrow fills.",
    "",
    "3. One Charcoal appears on the right. Click it and place it in your inventory.",
    "",
    "{image:firsttorch:textures/questpics/charcoal.png width:320 height:180 align:center}",
    "",
    "At the Crafting Table, put the Charcoal above one stick. Repeat the recipe twice to make eight Torches.",
    "",
    "Place torches inside your shelter, around the entrance, and along paths you want to find again.",
  ],
  "task.0F53BDE6197402AC.title": "Hold 8 Torches",

  "quest.1064CEF72A8513BD.title": "A Safe Shelter",
  "quest.1064CEF72A8513BD.quest_subtitle": "Walls, roof, light, and a closable entrance",
  "quest.1064CEF72A8513BD.quest_desc": [
    "Goal: prepare a small shelter before night.",
    "",
    "It needs solid walls, a roof, enough room to stand, light inside, and an entrance you can close with a door or blocks.",
    "",
    "Do not leave open gaps at ground level. Zombies and skeletons can attack through a bad entrance, and spiders can climb walls.",
    "",
    "Mark this quest when you can stand inside, close the entrance, and see clearly.",
  ],
  "task.2175DF083B9624CE.title": "My shelter is enclosed and lit",

  "quest.3286E0194CA735DF.title": "A Bed, If Possible",
  "quest.3286E0194CA735DF.quest_subtitle": "Skip the night and set your respawn point",
  "quest.3286E0194CA735DF.quest_desc": [
    "A bed is made from three wool across one row and three wooden planks directly below. Any wool colour works.",
    "",
    "Use a placed bed at night to sleep. Using it also sets your respawn point, so you return there after dying while the bed remains accessible.",
    "",
    "No sheep nearby? That is okay. Stay in your lit shelter and wait for daylight. Mark this quest when you have a bed or understand the safe waiting plan.",
  ],
  "task.4397F12A5DB846E0.title": "I have a bed or a safe waiting plan",

  "quest.54A8023B6EC957F1.title": "Morning Has Arrived",
  "quest.54A8023B6EC957F1.quest_subtitle": "Your first survival routine is complete",
  "quest.54A8023B6EC957F1.quest_desc": [
    "You now know the first survival loop: collect wood, craft basic tools, gather stone, make a furnace and torches, then secure a shelter.",
    "",
    "Stay near your shelter at first in the morning. Take spare blocks, tools, and torches, and remember where your shelter is. Food is taught in the next chapter; do not begin a long journey without it.",
    "",
    "Mark this quest after you have reached a safe morning. The next chapter will teach food, health, mining, and the equipment that makes you more independent.",
  ],
  "task.65B9134C7FDA6803.title": "I reached a safe morning",
}
